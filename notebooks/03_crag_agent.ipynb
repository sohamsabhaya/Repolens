    ")\n",
    "\n",
    "print(f\"🚀 LLM: {PRIMARY_MODEL}\")\n",
    "print(f\"🧠 Embeddings: {EMBEDDING_MODEL_NAME}\")\n",
    "print(f\"⚖️ Thresholds: UPPER={UPPER_TH}, LOWER={LOWER_TH}\")"
   ]

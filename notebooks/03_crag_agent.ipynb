    "TARGET_REPO = \"https://github.com/psf/requests.git\"\n",
    "\n",
    "vectorstore, target_dir = index_repository(TARGET_REPO)\n",
    "crag_agent = build_crag_nodes(vectorstore)\n",
    "\n",
    "print(\"\\n--- 📊 Visualizing CampusX CRAG StateGraph ---\")\n",
    "try:\n",
    "    display(Image(crag_agent.get_graph().draw_mermaid_png()))\n",
    "except Exception:\n",
    "    print(crag_agent.get_graph().draw_ascii())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step8-md",
   "metadata": {},
   "source": [
    "### Step 8: Interactive CRAG Testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step8-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "def ask_crag(question: str, session_id: str = \"crag_session\"):\n",
    "    res = crag_agent.invoke({\n",
    "        \"question\": question,\n",
    "        \"docs\": [],\n",
    "        \"good_docs\": [],\n",
    "        \"verdict\": \"\",\n",
    "        \"reason\": \"\",\n",
    "        \"strips\": [],\n",
    "        \"kept_strips\": [],\n",
    "        \"refined_context\": \"\",\n",
    "        \"web_docs\": [],\n",
    "        \"web_query\": \"\",\n",
    "        \"answer\": \"\",\n",
    "        \"citations\": []\n",
    "    }, config={\"configurable\": {\"thread_id\": session_id}})\n",
    "    \n",
    "    print(\"\\n==================== REPOLENS CRAG RESPONSE ====================\")\n",
    "    print(res[\"answer\"])\n",
    "    print(\"\\n--- Grounded Citations ---\")\n",
    "    for c in sorted(res[\"citations\"]):\n",
    "        print(f\"  * {c}\")\n",
    "    print(\"================================================================\\n\")\n",
    "\n",
    "# Test 1: In-domain Codebase Question (Expect Verdict: CORRECT)\n",
    "ask_crag(\"How does requests.Session manage cookies across HTTP requests?\")\n",
    "\n",
    "# Test 2: Out-of-domain / External Question (Expect Verdict: INCORRECT / AMBIGUOUS -> Fallback Search)\n",
    "ask_crag(\"What are the latest release notes and new features of Python 3.13?\")"
   ]
  }

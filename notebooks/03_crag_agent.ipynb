  {
   "cell_type": "markdown",
   "id": "step3-md",
   "metadata": {},
   "source": [
    "### Step 3: Ingestion & Vector Index Builder"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step3-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "IGNORE_DIRS = {\".git\", \"venv\", \".venv\", \"__pycache__\", \"node_modules\", \".idea\", \".vscode\", \"dist\", \"build\"}\n",
    "IGNORE_EXTENSIONS = {\".pyc\", \".png\", \".jpg\", \".jpeg\", \".gif\", \".svg\", \".ico\", \".zip\", \".tar\", \".gz\", \".exe\", \".dll\", \".so\"}\n",
    "VALID_EXTENSIONS = {\".py\", \".md\", \".txt\", \".toml\", \".yaml\", \".yml\", \".json\", \".sql\", \".sh\", \".env.example\"}\n",
    "\n",
    "def index_repository(repo_source: str) -> tuple[FAISS, Path]:\n",
    "    root_dir = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "    if repo_source.startswith((\"http://\", \"https://\", \"git@\")):\n",
    "        name = repo_source.rstrip(\"/\").split(\"/\")[-1].replace(\".git\", \"\")\n",
    "        target_dir = root_dir / \".indexes\" / \"cloned_repos\" / name\n",
    "        if not target_dir.exists():\n",
    "            target_dir.parent.mkdir(parents=True, exist_ok=True)\n",
    "            print(f\"Cloning {repo_source}...\")\n",
    "            git.Repo.clone_from(repo_source, str(target_dir), depth=50)\n",
    "    else:\n",
    "        target_dir = root_dir if repo_source in {\".\", \"local\", \"\"} else Path(repo_source).resolve()\n",
    "\n",
    "    docs = []\n",
    "    for root, dirs, files in os.walk(target_dir):\n",
    "        dirs[:] = [d for d in dirs if d not in IGNORE_DIRS]\n",
    "        for f in files:\n",
    "            fp = Path(root) / f\n",
    "            if fp.suffix.lower() in IGNORE_EXTENSIONS or fp.name.startswith(\".\"): continue\n",
    "            rel = fp.relative_to(target_dir).as_posix()\n",
    "            try:\n",
    "                txt = fp.read_text(encoding=\"utf-8\", errors=\"ignore\")\n",
    "                if txt.strip():\n",
    "                    docs.append(Document(\n",
    "                        page_content=f\"File: {rel}\\n\\n{txt[:2000]}\",\n",
    "                        metadata={\"file_path\": rel}\n",
    "                    ))\n",
    "            except Exception:\n",
    "                pass\n",
    "\n",
    "    print(f\"Generated {len(docs)} documents. Building FAISS index...\")\n",
    "    vstore = FAISS.from_documents(docs, embeddings)\n",
    "    return vstore, target_dir"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step4-md",
   "metadata": {},
   "source": [
    "### Step 4: CampusX CRAG State & Evaluator Schemas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step4-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "class CRAGState(TypedDict):\n",
    "    question: str\n",
    "    docs: List[Document]\n",
    "    good_docs: List[Document]\n",
    "    verdict: str           # 'CORRECT', 'INCORRECT', or 'AMBIGUOUS'\n",
    "    reason: str\n",
    "    strips: List[str]      # Decomposed knowledge strips\n",
    "    kept_strips: List[str] # Filtered relevant strips\n",
    "    refined_context: str\n",
    "    web_docs: List[Document]\n",
    "    web_query: str\n",
    "    answer: str\n",
    "    citations: List[str]\n",
    "\n",
    "# -----------------------------\n",
    "# Score-based Document Evaluator\n",
    "# -----------------------------\n",
    "class DocEvalScore(BaseModel):\n",
    "    score: float = Field(description=\"Relevance score between 0.0 and 1.0\")\n",
    "    reason: str = Field(description=\"Explanation for the relevance score\")\n",
    "\n",
    "eval_prompt = ChatPromptTemplate.from_messages([\n",
    "    (\"system\", \"\"\"You are an expert evaluator grading whether a retrieved code document is relevant to the user's question.\n",
    "Score the document from 0.0 (completely irrelevant) to 1.0 (highly relevant/directly answers).\n",
    "Return a score and concise reason.\"\"\"),\n",
    "    (\"user\", \"Question: {question}\\n\\nDocument Content:\\n{document}\")\n",
    "])\n",
    "\n",
    "# Structured Evaluator LLM\n",
    "evaluator_chain = eval_prompt | llm.with_structured_output(DocEvalScore)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step5-md",
   "metadata": {},
   "source": [
    "### Step 5: Knowledge Strip Decomposition & Query Rewriting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step5-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "# -----------------------------\n",
    "# Sentence / Strip Decomposer\n",
    "# -----------------------------\n",
    "def decompose_to_strips(text: str) -> List[str]:\n",
    "    \"\"\"Decomposes code documents into functional units / sentences.\"\"\"\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "    sentences = re.split(r\"(?<=[.!?\\n])\\s+\", text)\n",
    "    return [s.strip() for s in sentences if len(s.strip()) > 20]\n",
    "\n",
    "# -----------------------------\n",
    "# Query Rewriter for Fallback\n",
    "# -----------------------------\n",
    "class WebQuery(BaseModel):\n",
    "    query: str = Field(description=\"Rewritten technical search query\")\n",
    "\n",
    "rewrite_prompt = ChatPromptTemplate.from_messages([\n",
    "    (\"system\", \"Rewrite the user question into 2-3 specific technical keywords or function names for external search.\"),\n",
    "    (\"user\", \"User Question: {question}\")\n",
    "])\n",
    "rewriter_chain = rewrite_prompt | llm.with_structured_output(WebQuery)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step6-md",
   "metadata": {},
   "source": [
    "### Step 6: Define LangGraph CRAG Nodes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step6-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_crag_nodes(vstore: FAISS):\n",
    "    # 1. Retrieve Node\n",
    "    def retrieve_node(state: CRAGState) -> Dict[str, Any]:\n",
    "        q = state[\"question\"]\n",
    "        docs = vstore.similarity_search(q, k=4)\n",
    "        return {\"docs\": docs}\n",
    "\n",
    "    # 2. Document-by-Document Evaluation Node (CampusX Scoring)\n",
    "    def eval_each_doc_node(state: CRAGState) -> Dict[str, Any]:\n",
    "        q = state[\"question\"]\n",
    "        docs = state.get(\"docs\", [])\n",
    "        good_docs = []\n",
    "        scores = []\n",
    "        reasons = []\n",
    "\n",
    "        for d in docs:\n",
    "            try:\n",
    "                eval_res = evaluator_chain.invoke({\"question\": q, \"document\": d.page_content[:800]})\n",
    "                scores.append(eval_res.score)\n",
    "                reasons.append(eval_res.reason)\n",
    "                if eval_res.score >= LOWER_TH:\n",
    "                    good_docs.append(d)\n",
    "            except Exception:\n",
    "                scores.append(0.5)\n",
    "                good_docs.append(d)\n",
    "\n",
    "        max_score = max(scores) if scores else 0.0\n",
    "        \n",
    "        # Compute CampusX CRAG Verdict\n",
    "        if max_score >= UPPER_TH:\n",
    "            verdict = \"CORRECT\"\n",
    "        elif max_score < LOWER_TH:\n",
    "            verdict = \"INCORRECT\"\n",
    "        else:\n",
    "            verdict = \"AMBIGUOUS\"\n",
    "\n",
    "        print(f\"\\n[CRAG EVALUATOR] Max Score: {max_score:.2f} ➔ Verdict: {verdict}\")\n",
    "        return {\n",
    "            \"good_docs\": good_docs,\n",
    "            \"verdict\": verdict,\n",
    "            \"reason\": f\"Max score {max_score:.2f} ({verdict})\"\n",
    "        }\n",
    "\n",
    "    # 3. Knowledge Refinement Node (Strips decomposition)\n",
    "    def refine_node(state: CRAGState) -> Dict[str, Any]:\n",
    "        docs_to_refine = state.get(\"good_docs\") or state.get(\"docs\", [])\n",
    "        all_strips = []\n",
    "        for d in docs_to_refine:\n",
    "            all_strips.extend(decompose_to_strips(d.page_content))\n",
    "            \n",
    "        # Keep top most informative strips\n",
    "        kept = all_strips[:10]\n",
    "        refined_text = \"\\n\\n\".join(kept)\n",
    "        return {\n",
    "            \"strips\": all_strips,\n",
    "            \"kept_strips\": kept,\n",
    "            \"refined_context\": refined_text\n",
    "        }\n",
    "\n",
    "    # 4. Query Rewrite Node (For fallback)\n",
    "    def rewrite_query_node(state: CRAGState) -> Dict[str, Any]:\n",
    "        q = state[\"question\"]\n",
    "        try:\n",
    "            rw = rewriter_chain.invoke({\"question\": q})\n",
    "            web_q = rw.query\n",
    "        except Exception:\n",
    "            web_q = q\n",
    "        print(f\"[CRAG REWRITE] Rewritten Search Query: '{web_q}'\")\n",
    "        return {\"web_query\": web_q}\n",
    "\n",
    "    # 5. Web / Fallback Search Node\n",
    "    def web_search_node(state: CRAGState) -> Dict[str, Any]:\n",
    "        query = state.get(\"web_query\", state[\"question\"])\n",
    "        tavily_key = os.getenv(\"TAVILY_API_KEY\")\n",
    "        web_results = []\n",
    "        \n",
    "        if tavily_key and tavily_available:\n",
    "            try:\n",
    "                tool = TavilySearchResults(max_results=3)\n",
    "                raw_results = tool.invoke({\"query\": query})\n",
    "                for r in raw_results:\n",
    "                    web_results.append(Document(page_content=r[\"content\"], metadata={\"url\": r[\"url\"]}))\n",
    "                print(f\"[WEB SEARCH] Fetched {len(web_results)} web results via Tavily.\")\n",
    "            except Exception as e:\n",
    "                print(f\"[WEB SEARCH ERROR] {e}\")\n",
    "        else:\n",
    "            # Fallback internal broad search\n",
    "            web_results = vstore.similarity_search(query, k=2)\n",
    "            print(f\"[FALLBACK] Performed broader internal similarity search.\")\n",
    "            \n",
    "        return {\"web_docs\": web_results}\n",
    "\n",
    "    # 6. Generation Node\n",
    "    def generate_node(state: CRAGState) -> Dict[str, Any]:\n",
    "        q = state[\"question\"]\n",
    "        context = state.get(\"refined_context\", \"\")\n",
    "        web_docs = state.get(\"web_docs\", [])\n",
    "        \n",
    "        citations = []\n",
    "        for d in state.get(\"good_docs\", []):\n",
    "            fp = d.metadata.get(\"file_path\", \"code\")\n",
    "            citations.append(f\"Code: {fp}\")\n",
    "        for w in web_docs:\n",
    "            citations.append(f\"Web: {w.metadata.get('url', 'fallback')}\")\n",
    "\n",
    "        combined_context = f\"=== INTERNAL CODE CONTEXT ===\\n{context}\\n\\n\"\n",
    "        if web_docs:\n",
    "            web_parts = [f\"[Web Source] {w.page_content}\" for w in web_docs]\n",
    "            combined_context += f\"=== EXTERNAL SEARCH CONTEXT ===\\n\" + \"\\n\".join(web_parts)\n",
    "\n",
    "        prompt = f\"Context:\\n{combined_context}\\n\\nQuestion:\\n{q}\"\n",
    "        resp = llm.invoke([\n",
    "            {\"role\": \"system\", \"content\": \"You are RepoLens CRAG Assistant. Answer strictly using provided context and cite files.\"},\n",
    "            {\"role\": \"user\", \"content\": prompt}\n",
    "        ])\n",
    "        return {\"answer\": resp.content, \"citations\": list(set(citations))}\n",
    "\n",
    "    # -----------------------------\n",
    "    # CampusX Routing Decisions\n",
    "    # CORRECT => refine -> generate\n",
    "    # INCORRECT => rewrite_query -> web_search -> refine -> generate\n",
    "    # AMBIGUOUS => rewrite_query -> web_search -> refine -> generate\n",
    "    # -----------------------------\n",
    "    def route_after_eval(state: CRAGState) -> str:\n",
    "        verdict = state.get(\"verdict\", \"CORRECT\")\n",
    "        if verdict == \"CORRECT\":\n",
    "            return \"refine\"\n",
    "        else:\n",
    "            return \"rewrite_query\"\n",
    "\n",
    "    # Assemble LangGraph\n",
    "    g = StateGraph(CRAGState)\n",
    "    g.add_node(\"retrieve\", retrieve_node)\n",
    "    g.add_node(\"eval_each_doc\", eval_each_doc_node)\n",
    "    g.add_node(\"refine\", refine_node)\n",
    "    g.add_node(\"rewrite_query\", rewrite_query_node)\n",
    "    g.add_node(\"web_search\", web_search_node)\n",
    "    g.add_node(\"generate\", generate_node)\n",
    "\n",
    "    g.add_edge(START, \"retrieve\")\n",
    "    g.add_edge(\"retrieve\", \"eval_each_doc\")\n",
    "    g.add_conditional_edges(\"eval_each_doc\", route_after_eval, {\"refine\": \"refine\", \"rewrite_query\": \"rewrite_query\"})\n",
    "    g.add_edge(\"rewrite_query\", \"web_search\")\n",
    "    g.add_edge(\"web_search\", \"refine\")\n",
    "    g.add_edge(\"refine\", \"generate\")\n",
    "    g.add_edge(\"generate\", END)\n",
    "\n",
    "    return g.compile(checkpointer=MemorySaver())\n",
    "\n",
    "print(\"✅ CampusX CRAG Graph Builder ready.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step7-md",
   "metadata": {},
   "source": [
    "### Step 7: Ingest Target Repository & Visualize CRAG Architecture"
   ]
  },

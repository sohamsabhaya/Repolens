    "TARGET_REPO = \"https://github.com/psf/requests.git\"\n",
    "code_store, commit_store = build_dual_stores(TARGET_REPO)\n",
    "stage2_agent = create_stage2_agent(code_store, commit_store)\n",
    "\n",
    "print(\"\\n--- Visualizing Stage 2 Architecture ---\")\n",
    "try:\n",

   "source": [
    "### Step 7: Multi-Stream Q&A Loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step7-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "def ask_stage2(question: str, session_id: str = \"session_1\"):\n",
    "    res = stage2_agent.invoke({\n",
    "        \"question\": question,\n",
    "        \"code_docs\": [],\n",
    "        \"commit_docs\": [],\n",
    "        \"answer\": \"\",\n",
    "        \"citations\": []\n",
    "    }, config={\"configurable\": {\"thread_id\": session_id}})\n",
    "    \n",
    "    print(\"\\n==================== REPOLENS RESPONSE ====================\")\n",
    "    print(res[\"answer\"])\n",
    "    print(\"\\n--- Sources & Citations ---\")\n",
    "    for c in sorted(res[\"citations\"]):\n",
    "        print(f\"  * {c}\")\n",
    "    print(\"===========================================================\\n\")\n",
    "\n",
    "# Test git history query\n",
    "ask_stage2(\"What recent changes or commits were made in this repository?\")"
   ]
  }

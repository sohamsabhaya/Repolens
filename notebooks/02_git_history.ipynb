  {
   "cell_type": "markdown",
   "id": "step3-md",
   "metadata": {},
   "source": [
    "### Step 3: Git History & Diff Extractor"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step3-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "class GitHistoryExtractor:\n",
    "    IGNORE_DIFF_EXTENSIONS = {\".lock\", \".json\", \".svg\", \".png\", \".jpg\", \".min.js\"}\n",
    "    MAX_DIFF_CHARS = 2000\n",
    "\n",
    "    @classmethod\n",
    "    def extract_commits(cls, repo_path: Path, max_commits: int = 50) -> List[Document]:\n",
    "        try:\n",
    "            repo = git.Repo(repo_path, search_parent_directories=True)\n",
    "            commits = list(repo.iter_commits(max_count=max_commits))\n",
    "        except Exception as e:\n",
    "            print(f\"Warning: No git history found: {e}\")\n",
    "            return []\n",
    "\n",
    "        docs: List[Document] = []\n",
    "        for commit in commits:\n",
    "            sha = commit.hexsha[:8]\n",
    "            author = f\"{commit.author.name} <{commit.author.email}>\"\n",
    "            date_str = commit.committed_datetime.strftime(\"%Y-%m-%d %H:%M:%S\")\n",
    "            message = commit.message.strip()\n",
    "            \n",
    "            try: changed_files = list(commit.stats.files.keys())\n",
    "            except Exception: changed_files = []\n",
    "            \n",
    "            diff_text = \"\"\n",
    "            if commit.parents:\n",
    "                try:\n",
    "                    parent = commit.parents[0]\n",
    "                    diffs = parent.diff(commit, create_patch=True)\n",
    "                    diff_chunks = []\n",
    "                    for d in diffs:\n",
    "                        if any(d.a_path and d.a_path.endswith(ext) for ext in cls.IGNORE_DIFF_EXTENSIONS):\n",
    "                            continue\n",
    "                        if d.diff:\n",
    "                            patch = d.diff.decode(\"utf-8\", errors=\"ignore\")[:500]\n",
    "                            diff_chunks.append(f\"--- {d.a_path} ---\\n{patch}\")\n",
    "                    diff_text = \"\\n\".join(diff_chunks)[:cls.MAX_DIFF_CHARS]\n",
    "                except Exception:\n",
    "                    diff_text = \"\"\n",
    "            \n",
    "            content = (\n",
    "                f\"Commit SHA: {sha}\\n\"\n",
    "                f\"Author: {author}\\n\"\n",
    "                f\"Date: {date_str}\\n\"\n",
    "                f\"Commit Message: {message}\\n\"\n",
    "                f\"Files Modified: {', '.join(changed_files) if changed_files else 'None'}\\n\\n\"\n",
    "                f\"Diff Summary / Patch:\\n{diff_text if diff_text else 'No patch available.'}\"\n",
    "            )\n",
    "            docs.append(Document(\n",
    "                page_content=content,\n",
    "                metadata={\"source_type\": \"commit\", \"commit_sha\": sha, \"author\": commit.author.name, \"date\": date_str, \"message\": message[:80]}\n",
    "            ))\n",
    "        return docs"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step4-md",
   "metadata": {},
   "source": [
    "### Step 4: Dual FAISS Vector Store Builder (Code + Commits)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step4-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "IGNORE_DIRS = {\".git\", \"venv\", \".venv\", \"__pycache__\", \"node_modules\", \".idea\", \".vscode\", \"dist\", \"build\"}\n",
    "IGNORE_EXTENSIONS = {\".pyc\", \".png\", \".jpg\", \".jpeg\", \".gif\", \".svg\", \".ico\", \".zip\", \".tar\", \".gz\", \".exe\", \".dll\", \".so\"}\n",
    "\n",
    "def build_dual_stores(target_source: str):\n",
    "    root_dir = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "    if target_source.startswith((\"http://\", \"https://\", \"git@\")):\n",
    "        repo_name = target_source.rstrip(\"/\").split(\"/\")[-1].replace(\".git\", \"\")\n",
    "        target_path = root_dir / \".indexes\" / \"cloned_repos\" / repo_name\n",
    "        if not target_path.exists():\n",
    "            target_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "            git.Repo.clone_from(target_source, str(target_path), depth=50)\n",
    "    else:\n",
    "        target_path = root_dir if target_source in {\".\", \"local\", \"\"} else Path(target_source).resolve()\n",
    "\n",
    "    # 1. Code docs\n",
    "    code_docs = []\n",
    "    for root, dirs, files in os.walk(target_path):\n",
    "        dirs[:] = [d for d in dirs if d not in IGNORE_DIRS]\n",
    "        for f in files:\n",
    "            file_p = Path(root) / f\n",
    "            if file_p.suffix.lower() in IGNORE_EXTENSIONS or file_p.name.startswith(\".\"): continue\n",
    "            rel_path = file_p.relative_to(target_path).as_posix()\n",
    "            try:\n",
    "                txt = file_p.read_text(encoding=\"utf-8\", errors=\"ignore\")\n",
    "                if txt.strip():\n",
    "                    code_docs.append(Document(page_content=f\"File: {rel_path}\\n\\n{txt[:1500]}\", metadata={\"file_path\": rel_path, \"source_type\": \"code\"}))\n",
    "            except Exception:\n",
    "                pass\n",
    "                \n",
    "    print(f\"Indexed {len(code_docs)} code chunks.\")\n",
    "    code_store = FAISS.from_documents(code_docs, embeddings) if code_docs else None\n",
    "    \n",
    "    # 2. Commit docs\n",
    "    commit_docs = GitHistoryExtractor.extract_commits(target_path, max_commits=40)\n",
    "    print(f\"Indexed {len(commit_docs)} commit records.\")\n",
    "    commit_store = FAISS.from_documents(commit_docs, embeddings) if commit_docs else None\n",
    "    \n",
    "    return code_store, commit_store"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step5-md",
   "metadata": {},
   "source": [
    "### Step 5: Multi-Stream LangGraph State & Agent"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "id": "step5-code",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Stage2State(TypedDict):\n",
    "    question: str\n",
    "    code_docs: List[Document]\n",
    "    commit_docs: List[Document]\n",
    "    answer: str\n",
    "    citations: List[str]\n",
    "\n",
    "def create_stage2_agent(code_store: Optional[FAISS], commit_store: Optional[FAISS]):\n",
    "    def retrieve_node(state: Stage2State) -> Dict[str, Any]:\n",
    "        q = state[\"question\"]\n",
    "        c_docs = code_store.similarity_search(q, k=4) if code_store else []\n",
    "        cm_docs = commit_store.similarity_search(q, k=3) if commit_store else []\n",
    "        return {\"code_docs\": c_docs, \"commit_docs\": cm_docs}\n",
    "\n",
    "    def generate_node(state: Stage2State) -> Dict[str, Any]:\n",
    "        q = state[\"question\"]\n",
    "        c_docs = state.get(\"code_docs\", [])\n",
    "        cm_docs = state.get(\"commit_docs\", [])\n",
    "        \n",
    "        citations = []\n",
    "        parts = []\n",
    "        for i, d in enumerate(c_docs, 1):\n",
    "            fp = d.metadata.get(\"file_path\", \"unknown\")\n",
    "            citations.append(f\"Code: {fp}\")\n",
    "            parts.append(f\"--- Code Doc {i} [{fp}] ---\\n{d.page_content}\")\n",
    "        for i, d in enumerate(cm_docs, 1):\n",
    "            sha = d.metadata.get(\"commit_sha\", \"unknown\")\n",
    "            auth = d.metadata.get(\"author\", \"unknown\")\n",
    "            date_val = d.metadata.get(\"date\", \"unknown\")\n",
    "            tag = f\"commit:{sha} by {auth} on {date_val}\"\n",
    "            citations.append(f\"Git: [{tag}]\")\n",
    "            parts.append(f\"--- Commit Doc {i} [{tag}] ---\\n{d.page_content}\")\n",
    "            \n",
    "        ctx = \"\\n\\n\".join(parts) if parts else \"No context found.\"\n",
    "        prompt = f\"Context:\\n{ctx}\\n\\nQuestion:\\n{q}\"\n",
    "        resp = llm.invoke([\n",
    "            {\"role\": \"system\", \"content\": \"You are RepoLens. Answer grounded in context and cite both code and commits.\"}, \n",
    "            {\"role\": \"user\", \"content\": prompt}\n",
    "        ])\n",
    "        return {\"answer\": resp.content, \"citations\": list(set(citations))}\n",
    "\n",
    "    builder = StateGraph(Stage2State)\n",
    "    builder.add_node(\"retrieve\", retrieve_node)\n",
    "    builder.add_node(\"generate\", generate_node)\n",
    "    builder.add_edge(START, \"retrieve\")\n",
    "    builder.add_edge(\"retrieve\", \"generate\")\n",
    "    builder.add_edge(\"generate\", END)\n",
    "    return builder.compile(checkpointer=MemorySaver())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "step6-md",
   "metadata": {},
   "source": [
    "### Step 6: Ingest Target Repository & Visualize Architecture"
   ]
